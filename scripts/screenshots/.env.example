# Local dashboard-ce (yarn serve). Default port in dashboard-ce/dev.server.config.js is 8081.
DASHBOARD_URL=http://localhost:8081

DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional login domain (shown when the environment has multiple domains)
DASHBOARD_DOMAIN=

# Set to 1 to run Chromium with a visible window
# HEADED=1

# Screenshot device pixel ratio (default 2 for sharper docs images)
# SCREENSHOT_DPR=2

# Force API login (skip UI form; useful when captcha is enabled)
# DASHBOARD_LOGIN_MODE=api
